{
  "name": "@lucianopignotti/passport-stamps",
  "version": "0.1.0",
  "description": "193 countries and 238 destinations as lightweight passport-style SVG stamps",
  "type": "module",
  "license": "MIT",
  "files": [
    "svg",
    "manifest.json",
    "destinations.json",
    "README.md",
    "LICENSE",
    "docs/SOURCES.md",
    "data/un-members.json",
    "docs/DESTINATIONS.md"
  ],
  "exports": {
    "./svg/*": "./svg/*",
    "./manifest.json": "./manifest.json",
    "./destinations.json": "./destinations.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node --test tests/catalog.test.mjs",
    "preview": "python3 -m http.server 4173 --bind 127.0.0.1",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Luciano Pignotti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pignottiluciano/passport-stamps.git"
  },
  "homepage": "https://pignottiluciano.github.io/passport-stamps/",
  "bugs": {
    "url": "https://github.com/pignottiluciano/passport-stamps/issues"
  },
  "keywords": [
    "svg",
    "passport",
    "stamps",
    "travel",
    "countries",
    "cities"
  ],
  "publishConfig": {
    "access": "public"
  }
}
