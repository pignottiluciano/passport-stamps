{
  "name": "@lucianopignotti/passport-stamps",
  "version": "0.4.0",
  "description": "193 countries and 238 destinations as lightweight passport-style SVG stamps",
  "type": "module",
  "license": "MIT",
  "files": [
    "svg",
    "manifest.json",
    "destinations.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/SOURCES.md",
    "data/un-members.json",
    "docs/DESTINATIONS.md",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./element": {
      "types": "./dist/element/index.d.ts",
      "default": "./dist/element/index.js"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "default": "./dist/angular/fesm2022/lucianopignotti-passport-stamps-angular-build.mjs"
    },
    "./svg/*": "./svg/*",
    "./manifest.json": "./manifest.json",
    "./destinations.json": "./destinations.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-library.mjs",
    "check": "node scripts/build.mjs --check && tsc --noEmit --strict --module NodeNext --skipLibCheck tests/catalog-types.ts && node --test tests/catalog.test.mjs tests/components-core.test.mjs && vitest run",
    "preview": "python3 -m http.server 4173 --bind 127.0.0.1",
    "prepack": "npm run build && npm run check"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "Luciano Pignotti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pignottiluciano/passport-stamps.git"
  },
  "homepage": "https://pignottiluciano.github.io/passport-stamps/",
  "bugs": {
    "url": "https://github.com/pignottiluciano/passport-stamps/issues"
  },
  "keywords": [
    "svg",
    "passport",
    "stamps",
    "travel",
    "countries",
    "cities"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@angular/common": "20.3.35",
    "@angular/compiler": "20.3.35",
    "@angular/compiler-cli": "20.3.35",
    "@angular/core": "20.3.35",
    "@angular/platform-browser": "20.3.35",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "27.4.0",
    "ng-packagr": "20.3.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "sideEffects": false,
  "types": "./dist/core/index.d.ts",
  "peerDependencies": {
    "@angular/core": ">=20 <23",
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
